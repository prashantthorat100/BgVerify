ENVIRONMENT=development
PROJECT_NAME=BGVerify.ai
VERSION=1.0.0
SECRET_KEY=bgverify-super-secure-production-ready-jwt-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# For local development SQLite is enabled by default.
# For production PostgreSQL, set:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bgverify
DATABASE_URL=sqlite:///./bgverify.db

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=15728640
